+/// Ravenry (daemon/patches/ghostty-redraw-history.patch): remove a run of
+/// the primary screen's scrollback, n rows from row y (0 the oldest row),
+/// the first of them from column x on (Screen.ravenryEraseHistory); the
+/// screen keeps its rows. erased, when given, gets how many rows went.
+pub fn ravenry_erase_history(
+    terminal_: Terminal,
+    y: usize,
+    x: usize,
+    n: usize,
+    erased: ?*usize,
+) callconv(lib.calling_conv) Result {
+    const wrapper = terminal_ orelse return .invalid_value;
+    const t: *ZigTerminal = wrapper.terminal;
+    const screen = t.screens.get(.primary) orelse return .invalid_value;
+    const done = screen.ravenryEraseHistory(y, x, n);
+    if (erased) |e| e.* = done;
+    return .success;
+}
