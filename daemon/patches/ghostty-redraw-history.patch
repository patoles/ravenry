+/// Ravenry (daemon/patches/ghostty-redraw-history.patch): remove a stale
+/// run of the scrollback, n rows from row y (screen coordinates, 0 the
+/// oldest row), the first of them from column x on: with x > 0 that row
+/// stays with its cells before x, cleared from x and no longer wrapping.
+/// The rows under the run move up and the screen shows the same rows as
+/// before. The row above a run taken whole wraps no more into it. Returns
+/// how many rows went: none past the scrollback's end.
+/// The daemon removes this way the stale copy of rows that a program,
+/// which erased its screen and drew its frame again from the top, has
+/// just drawn once more under them (vt, redraw.go).
+pub fn ravenryEraseHistory(self: *Screen, y: usize, x: usize, n: usize) usize {
+    const hist = self.pages.total_rows -| self.pages.rows;
+    if (y >= hist or n == 0) return 0;
+    var first = y;
+    var count = @min(n, hist - y);
+    if (x > 0) {
+        const p = self.pages.pin(.{ .screen = .{ .y = @intCast(y) } }) orelse return 0;
+        const rac = p.rowAndCell();
+        const cells = p.cells(.all);
+        if (x < cells.len) self.clearCells(p.node.page(), rac.row, cells[x..]);
+        rac.row.wrap = false;
+        rac.row.dirty = true;
+        first = y + 1;
+        count -= 1;
+    } else if (y > 0) {
+        if (self.pages.pin(.{ .screen = .{ .y = @intCast(y - 1) } })) |p| {
+            p.rowAndCell().row.wrap = false;
+        }
+    }
+    var done: usize = 0;
+    while (done < count) : (done += 1) {
+        self.pages.eraseRow(.{ .screen = .{ .y = @intCast(first) } }) catch break;
+    }
+    // Each erased row went to the end of the list as a blank row: drop
+    // them there, so the screen's window moves up over the scrollback.
+    const trimmed = self.pages.ravenryTrimBottom(done);
+    self.cursorReload();
+    return trimmed;
+}
