+/// Ravenry (daemon/patches/ghostty-prompt-clear-top.patch).
+const PromptRedraw = struct {
+    /// Rows from the prompt's first row down to the cursor's, as the
+    /// shell drew them: the shell's redraw moves up by this many.
+    rows: usize,
+    /// The cursor's column, which the shell also counts from.
+    x: size.CellCountInt,
+};
+
+/// Ravenry (daemon/patches/ghostty-prompt-clear-top.patch): a resize at a
+/// prompt the shell redraws (OSC 133 redraw), done before the reflow.
+///
+/// The shell redraws its prompt by moving up the rows it drew it on, at
+/// the old width, and drawing again from there. Upstream clears the
+/// prompt after the reflow, from its first row down, but the reflow has
+/// changed its height: narrower, the prompt took more rows, the shell's
+/// redraw started below its first row, and the rows between stayed blank;
+/// once the command line was taller than the screen (zsh then draws only
+/// its end, under a ">...." row) the reflow pushed the prompt's first
+/// rows into the scrollback, where no redraw reaches, and each step of a
+/// drag left a ">...." row there. Wider, the redraw started above the
+/// prompt, over the output before it. The blank rows kept their soft-wrap
+/// flags too, so a later reflow joined what the shell drew next onto
+/// them ("~ > >....   ~ > >...." side by side once wide again).
+///
+/// So: clear the prompt from its first row (found through soft-wrapped
+/// rows and continuations, which promptIterator stops at) to the end of
+/// the screen, rows reset whole, and put the cursor on that first row
+/// for the reflow. The cleared prompt is then one blank row that never
+/// grows, and nothing of it reaches the scrollback. After the reflow,
+/// placeCursorForRedraw puts the cursor as many rows below it as the
+/// shell will move up, so the redraw starts on the prompt's first row:
+/// the output above stays, and no row of an old prompt is left.
+fn clearPromptBeforeReflow(self: *Screen) ?PromptRedraw {
+    if (self.cursor.semantic_content == .output) return null;
+
+    const start = start: {
+        var it = self.cursor.page_pin.promptIterator(.left_up, null);
+        break :start it.next() orelse {
+            log.warn("cursor on prompt line but promptIterator found no prompt", .{});
+            return null;
+        };
+    };
+    var top = top: {
+        var p = self.cursor.page_pin.left(self.cursor.page_pin.x);
+        while (true) {
+            const row = p.rowAndCell().row;
+            if (!row.wrap_continuation) switch (row.semantic_prompt) {
+                .prompt => break :top p,
+                .prompt_continuation => {},
+                .none => break :top start.left(start.x),
+            };
+            p = p.up(1) orelse break :top start.left(start.x);
+        }
+    };
+
+    const cursor_y = self.pages.pointFromPin(.screen, self.cursor.page_pin.*).?.screen.y;
+    var rows: usize = cursor_y -| self.pages.pointFromPin(.screen, top).?.screen.y;
+
+    // A first row the prompt wrapped onto from the row above: that row no
+    // longer wraps, or the reflow would join the cleared row onto it.
+    if (top.rowAndCell().row.wrap_continuation) {
+        if (top.up(1)) |above| above.rowAndCell().row.wrap = false;
+    }
+
+    // A first row in the scrollback, where the shell's redraw never
+    // reaches (it stops at the top of the screen): those rows are
+    // cleared as upstream does, and the redraw starts at the top.
+    if (self.pages.pointFromPin(.active, top) == null) {
+        const active_top = self.pages.getTopLeft(.active);
+        var it = top.rowIterator(.right_down, active_top.up(1));
+        while (it.next()) |pin| self.clearRowWhole(pin);
+        top = active_top;
+        rows = self.cursor.y;
+    }
+
+    var it = top.rowIterator(.right_down, null);
+    while (it.next()) |pin| self.clearRowWhole(pin);
+    top.rowAndCell().row.semantic_prompt = .prompt;
+
+    const x = self.cursor.x;
+    self.cursorAbsolute(0, @intCast(self.pages.pointFromPin(.active, top).?.active.y));
+    self.cursor.pending_wrap = false;
+    return .{ .rows = rows, .x = x };
+}
+
+/// Ravenry: clear a row's cells and reset its flags (soft wrap, semantic
+/// prompt), as a fresh row.
+fn clearRowWhole(self: *Screen, pin: Pin) void {
+    const page = pin.node.page();
+    const row = pin.rowAndCell().row;
+    self.clearCells(page, row, page.getCells(row));
+    row.* = .{ .cells = row.cells, .blank = row.blank, .dirty = true };
+}
+
+/// Ravenry: after the reflow, the cursor is on the cleared prompt's first
+/// row. Move it down the rows the shell will move up, marking them as the
+/// prompt's, so the redraw lands on that first row. Past the bottom of the
+/// screen the screen scrolls, as the shell's own lines did, but never
+/// takes the prompt's first row off it: the shell's move up stops at the
+/// top of the screen (a screen now shorter than the prompt), and a row
+/// scrolled off would stay in the scrollback, blank.
+fn placeCursorForRedraw(self: *Screen, pr: PromptRedraw) void {
+    var top = self.cursor.y;
+    var n = pr.rows;
+    while (n > 0) : (n -= 1) {
+        if (self.cursor.y + 1 < self.pages.rows) {
+            self.cursorDown(1);
+        } else if (top > 0) {
+            self.cursorDownScroll() catch break;
+            top -= 1;
+        } else break;
+        self.cursor.page_row.semantic_prompt = .prompt_continuation;
+    }
+    self.cursorHorizontalAbsolute(@min(pr.x, self.pages.cols - 1));
+}
+
 fn clearPromptForRedraw(
     self: *Screen,
     redraw: osc.semantic_prompt.Redraw,
