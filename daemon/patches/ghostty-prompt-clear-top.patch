+/// Ravenry (daemon/patches/ghostty-prompt-clear-top.patch).
+const PromptRedraw = struct {
+    /// Rows from the prompt's first row down to the cursor's, as the
+    /// shell drew them: the shell's redraw moves up by this many.
+    rows: usize,
+    /// The cursor's column, which the shell also counts from.
+    x: size.CellCountInt,
+    /// The command line kept through the reflow (keepCommandForReflow).
+    kept: ?KeptCommand = null,
+};
+
+/// Ravenry: a command line kept through a resize, its first row and its
+/// last tracked.
+const KeptCommand = struct {
+    first: *Pin,
+    last: *Pin,
+};
+
+/// Ravenry (daemon/patches/ghostty-prompt-clear-top.patch): a resize at a
+/// prompt the shell redraws (OSC 133 redraw), done before the reflow.
+///
+/// The shell redraws its prompt by moving up the rows it drew it on, at
+/// the old width, and drawing again from there. Upstream clears the
+/// prompt after the reflow, from its first row down, but the reflow has
+/// changed its height: narrower, the prompt took more rows, the shell's
+/// redraw started below its first row, and the rows between stayed blank;
+/// once the command line was taller than the screen (zsh then draws only
+/// its end, under a ">...." row) the reflow pushed the prompt's first
+/// rows into the scrollback, where no redraw reaches, and each step of a
+/// drag left a ">...." row there. Wider, the redraw started above the
+/// prompt, over the output before it. The blank rows kept their soft-wrap
+/// flags too, so a later reflow joined what the shell drew next onto
+/// them ("~ > >....   ~ > >...." side by side once wide again).
+///
+/// So: clear the prompt from its first row (found through soft-wrapped
+/// rows and continuations, which promptIterator stops at) to the end of
+/// the screen, rows reset whole, and put the cursor on that first row
+/// for the reflow. The cleared prompt is then one blank row that never
+/// grows, and nothing of it reaches the scrollback. After the reflow,
+/// placeCursorForRedraw puts the cursor as many rows below it as the
+/// shell will move up, so the redraw starts on the prompt's first row:
+/// the output above stays, and no row of an old prompt is left.
+fn clearPromptBeforeReflow(self: *Screen) ?PromptRedraw {
+    if (self.cursor.semantic_content == .output) return null;
+
+    const start = start: {
+        var it = self.cursor.page_pin.promptIterator(.left_up, null);
+        break :start it.next() orelse {
+            log.warn("cursor on prompt line but promptIterator found no prompt", .{});
+            return null;
+        };
+    };
+    var top = top: {
+        var p = self.cursor.page_pin.left(self.cursor.page_pin.x);
+        while (true) {
+            const row = p.rowAndCell().row;
+            if (!row.wrap_continuation) switch (row.semantic_prompt) {
+                .prompt => break :top p,
+                .prompt_continuation => {},
+                .none => break :top start.left(start.x),
+            };
+            p = p.up(1) orelse break :top start.left(start.x);
+        }
+    };
+
+    const cursor_y = self.pages.pointFromPin(.screen, self.cursor.page_pin.*).?.screen.y;
+    var rows: usize = cursor_y -| self.pages.pointFromPin(.screen, top).?.screen.y;
+
+    if (self.keepCommandForReflow(top, rows)) |pr| return pr;
+
+    // A first row the prompt wrapped onto from the row above: that row no
+    // longer wraps, or the reflow would join the cleared row onto it.
+    if (top.rowAndCell().row.wrap_continuation) {
+        if (top.up(1)) |above| above.rowAndCell().row.wrap = false;
+    }
+
+    // A first row in the scrollback, where the shell's redraw never
+    // reaches (it stops at the top of the screen): those rows are
+    // cleared as upstream does, and the redraw starts at the top.
+    if (self.pages.pointFromPin(.active, top) == null) {
+        const active_top = self.pages.getTopLeft(.active);
+        var it = top.rowIterator(.right_down, active_top.up(1));
+        while (it.next()) |pin| self.clearRowWhole(pin);
+        top = active_top;
+        rows = self.cursor.y;
+    }
+
+    var it = top.rowIterator(.right_down, null);
+    while (it.next()) |pin| self.clearRowWhole(pin);
+    top.rowAndCell().row.semantic_prompt = .prompt;
+
+    const x = self.cursor.x;
+    self.cursorAbsolute(0, @intCast(self.pages.pointFromPin(.active, top).?.active.y));
+    self.cursor.pending_wrap = false;
+    return .{ .rows = rows, .x = x };
+}
+
+/// Ravenry (daemon/patches/ghostty-prompt-clear-top.patch): a command
+/// line taller than the screen, scrolled up from the prompt, shows its
+/// start once, as one clean copy.
+///
+/// zsh draws a command line taller than the screen as ">...." on the
+/// prompt's row and the end of the command line under it; the start is
+/// never drawn again. Clearing the prompt on each resize (above) left no
+/// row of it in the scrollback, so nothing could be scrolled to, and
+/// leaving it, as Ghostty upstream does, keeps every old layout of it
+/// there, out of order. So the command line, while the shell draws it
+/// whole, is kept through the reflow, which lays it out at the new width
+/// as the shell would; when it no longer fits, its rows above the ones
+/// the shell will draw under ">...." stay in the scrollback, the first
+/// marked (ravenry_head), and the screen is cleared for the shell. At
+/// the next resize those kept rows and the shell's end of the command
+/// line, without the ">...." row, are the whole command line again, laid
+/// out once more; when it fits again, the kept rows are cleared and the
+/// shell draws it all. A command line the shell never drew whole (pasted
+/// into a window already too short) has nothing to keep and is cleared as
+/// before. After the command runs, the kept rows are scrollback like any.
+fn keepCommandForReflow(self: *Screen, top: Pin, rows: usize) ?PromptRedraw {
+    const x = self.cursor.x;
+    var first = top.left(top.x);
+    var more_row: ?Pin = null;
+    if (rowEndsWithMore(top)) {
+        // The shell draws only the end: the kept start must be above.
+        if (self.pages.pointFromPin(.active, top) == null) return null;
+        first = findKeptHead(top) orelse return null;
+        more_row = top.left(top.x);
+    } else if (first.rowAndCell().row.wrap_continuation) {
+        return null;
+    }
+    // The command line's last row: the last row with text from the
+    // cursor's row down.
+    var last = self.cursor.page_pin.left(self.cursor.page_pin.x);
+    var it = last.rowIterator(.right_down, null);
+    while (it.next()) |p| {
+        if (pagepkg.Cell.hasTextAny(p.cells(.all))) last = p;
+    }
+    const f = self.pages.trackPin(first) catch return null;
+    const l = self.pages.trackPin(last) catch {
+        self.pages.untrackPin(f);
+        return null;
+    };
+    // zsh moves to a new row after a line that fills the width, so such a
+    // line has an empty row under it: not part of the command line, and
+    // at another width the line no longer fills it. It goes, so the
+    // reflow lays out only the command line.
+    {
+        var p = f.*;
+        while (p.node != l.node or p.y != l.y) {
+            const next = p.down(1) orelse break;
+            if (next.node == l.node and next.y == l.y) break;
+            const row = p.rowAndCell().row;
+            const cells = p.cells(.all);
+            if (!row.wrap and cells.len > 0 and cells[cells.len - 1].hasText() and
+                !next.rowAndCell().row.wrap and !pagepkg.Cell.hasTextAny(next.cells(.all)) and
+                (more_row == null or next.node != more_row.?.node or next.y != more_row.?.y))
+            {
+                const y = self.pages.pointFromPin(.screen, next).?.screen.y;
+                self.pages.eraseRow(.{ .screen = .{ .y = @intCast(y) } }) catch break;
+                continue;
+            }
+            p = next;
+        }
+    }
+    if (more_row) |m| {
+        // The kept rows and the end the shell drew under ">...." are one
+        // command line again: the last kept row wraps as it did, and the
+        // ">...." row goes.
+        const above = m.up(1).?;
+        above.rowAndCell().row.wrap = above.rowAndCell().row.ravenry_wrap;
+        above.rowAndCell().row.ravenry_wrap = false;
+        const y = self.pages.pointFromPin(.active, m).?.active.y;
+        self.pages.eraseRow(.{ .active = .{ .y = y } }) catch {
+            self.pages.untrackPin(f);
+            self.pages.untrackPin(l);
+            return null;
+        };
+        if (above.down(1)) |next| next.rowAndCell().row.wrap_continuation = above.rowAndCell().row.wrap;
+        self.cursorReload();
+    }
+    // The previous mark goes; placeKeptCommand marks the first row again
+    // when rows stay kept.
+    f.rowAndCell().row.ravenry_head = false;
+    return .{ .rows = rows, .x = x, .kept = .{ .first = f, .last = l } };
+}
+
+/// Ravenry: the row ends with zsh's ">...." mark.
+fn rowEndsWithMore(p: Pin) bool {
+    const cells = p.cells(.all);
+    var end: usize = cells.len;
+    // zsh pads the row with spaces.
+    while (end > 0 and (!cells[end - 1].hasText() or cells[end - 1].codepoint() == ' ')) end -= 1;
+    if (end < 5) return false;
+    const want = [_]u21{ '>', '.', '.', '.', '.' };
+    for (want, 0..) |c, i| {
+        if (cells[end - 5 + i].codepoint() != c) return false;
+    }
+    return true;
+}
+
+/// Ravenry: the first row of the kept start of the command line whose
+/// ">...." row is top: up from it through the command line's rows to the
+/// marked one. Output, or another prompt, on the way: none.
+fn findKeptHead(top: Pin) ?Pin {
+    var p = top.up(1) orelse return null;
+    var n: usize = 0;
+    while (n < 100_000) : (n += 1) {
+        const row = p.rowAndCell().row;
+        if (row.ravenry_head) {
+            // The reflow marks each row of the first line: its first.
+            while (p.rowAndCell().row.wrap_continuation) p = p.up(1) orelse break;
+            return p.left(p.x);
+        }
+        if (!row.wrap_continuation and row.semantic_prompt == .prompt) return null;
+        for (p.cells(.all)) |c| {
+            if (c.hasText() and c.semantic_content == .output) return null;
+        }
+        p = p.up(1) orelse return null;
+    }
+    return null;
+}
+
+/// Ravenry: after the reflow, the kept command line at the new width.
+/// When it fits on the screen, the shell draws it all: it is cleared from
+/// its first row, which comes onto the screen if the reflow left it in
+/// the scrollback. When it does not, the screen starts on the row after
+/// those the shell will not draw (it draws ">...." and the last rows - 1
+/// rows under it), the rows above stay in the scrollback, marked, and the
+/// screen is cleared for the shell.
+fn placeKeptCommand(self: *Screen, pr: PromptRedraw) void {
+    const k = pr.kept.?;
+    var untracked = false;
+    defer if (!untracked) {
+        self.pages.untrackPin(k.first);
+        self.pages.untrackPin(k.last);
+    };
+    if (k.first.garbage or k.last.garbage) return self.placeCursorForRedraw(pr);
+    const first_y = (self.pages.pointFromPin(.screen, k.first.*) orelse return self.placeCursorForRedraw(pr)).screen.y;
+    const last_y = (self.pages.pointFromPin(.screen, k.last.*) orelse return self.placeCursorForRedraw(pr)).screen.y;
+    const rows: usize = self.pages.rows;
+    const active_top = self.pages.pointFromPin(.screen, self.pages.getTopLeft(.active)).?.screen.y;
+
+    // The command line's rows as zsh counts them: a line that fills the
+    // width takes a row more (zsh moves under it). zsh draws it whole
+    // when they fit on the screen; otherwise ">...." and the last rows - 1
+    // of them, and the target, the screen's first row, is the row after
+    // the first n - rows + 1 of them, in the rows the reflow made.
+    const count = last_y - first_y + 1;
+    const n = self.zshRows(k.first.*, count);
+    const fits = n <= rows;
+    const target_y = if (fits) first_y else first_y + self.zshCut(k.first.*, count, n - rows + 1);
+
+    // The last row's pin would stop the trim below.
+    self.pages.untrackPin(k.last);
+    if (target_y < active_top) {
+        // The target is in the scrollback: clear from it down, then bring
+        // it to the screen's top by dropping as many blank rows at the
+        // end.
+        const tp = self.pages.pin(.{ .screen = .{ .y = @intCast(target_y) } }).?;
+        var it = tp.rowIterator(.right_down, null);
+        while (it.next()) |p| self.clearRowWhole(p);
+        self.cursorChangePin(tp);
+        _ = self.pages.ravenryTrimBottom(active_top - target_y);
+        self.cursorReload();
+    } else if (!fits and target_y > active_top) {
+        // Rows of the start still on the screen go up into the scrollback.
+        var d = target_y - active_top;
+        self.cursorAbsolute(0, @intCast(rows - 1));
+        while (d > 0) : (d -= 1) self.cursorDownScroll() catch break;
+    }
+
+    // The screen from the command's first row (it fits) or from the top
+    // (it does not) is the shell's to draw.
+    const start: Pin = if (fits)
+        (if (k.first.garbage) self.pages.getTopLeft(.active) else k.first.*)
+    else
+        self.pages.getTopLeft(.active);
+    var it = start.rowIterator(.right_down, null);
+    while (it.next()) |p| self.clearRowWhole(p);
+    start.rowAndCell().row.semantic_prompt = .prompt;
+    if (!fits and !k.first.garbage) {
+        k.first.rowAndCell().row.ravenry_head = true;
+        // The kept rows' last row: its soft wrap onto the row the shell
+        // draws ">...." on is kept apart, so a copy does not join them.
+        if (start.up(1)) |above| {
+            const row = above.rowAndCell().row;
+            row.ravenry_wrap = row.wrap;
+            row.wrap = false;
+        }
+    }
+    self.pages.untrackPin(k.first);
+    untracked = true;
+    const y = self.pages.pointFromPin(.active, start).?.active.y;
+    self.cursorAbsolute(0, @intCast(y));
+    self.cursor.pending_wrap = false;
+    self.placeCursorForRedraw(.{ .rows = pr.rows, .x = pr.x });
+}
+
+/// Ravenry: the rows zsh counts for a command line laid out over count
+/// rows from first.
+fn zshRows(self: *Screen, first: Pin, count: usize) usize {
+    return self.zshCut(first, count, std.math.maxInt(usize));
+}
+
+/// Ravenry: the rows of one logical line of g rows ending on row last:
+/// as laid out, and one more when its last row is full (zsh moves under
+/// a line that fills the width).
+fn zshLineRows(g: usize, last: Pin) usize {
+    const cells = last.cells(.all);
+    if (cells.len > 0 and cells[cells.len - 1].hasText()) return g + 1;
+    return g;
+}
+
+/// Ravenry: of the rows the reflow made from first (count of them), how
+/// many hold the first k rows zsh counts; with k past the end, the rows
+/// zsh counts for them all.
+fn zshCut(self: *Screen, first: Pin, count: usize, k: usize) usize {
+    _ = self;
+    var zr: usize = 0;
+    var p = first;
+    var i: usize = 0;
+    while (i < count) {
+        // One logical line: rows joined by soft wraps.
+        var g: usize = 1;
+        var q = p;
+        while (q.rowAndCell().row.wrap and i + g < count) : (g += 1) q = q.down(1) orelse break;
+        const z = zshLineRows(g, q);
+        if (k != std.math.maxInt(usize) and zr + z >= k) return i + @min(k - zr, g);
+        zr += z;
+        i += g;
+        p = q.down(1) orelse break;
+    }
+    return if (k == std.math.maxInt(usize)) zr else count;
+}
+
+/// Ravenry: clear a row's cells and reset its flags (soft wrap, semantic
+/// prompt), as a fresh row.
+fn clearRowWhole(self: *Screen, pin: Pin) void {
+    const page = pin.node.page();
+    const row = pin.rowAndCell().row;
+    self.clearCells(page, row, page.getCells(row));
+    row.* = .{ .cells = row.cells, .blank = row.blank, .dirty = true };
+}
+
+/// Ravenry: after the reflow, the cursor is on the cleared prompt's first
+/// row. Move it down the rows the shell will move up, marking them as the
+/// prompt's, so the redraw lands on that first row. Past the bottom of the
+/// screen the screen scrolls, as the shell's own lines did, but never
+/// takes the prompt's first row off it: the shell's move up stops at the
+/// top of the screen (a screen now shorter than the prompt), and a row
+/// scrolled off would stay in the scrollback, blank.
+fn placeCursorForRedraw(self: *Screen, pr: PromptRedraw) void {
+    var top = self.cursor.y;
+    var n = pr.rows;
+    while (n > 0) : (n -= 1) {
+        if (self.cursor.y + 1 < self.pages.rows) {
+            self.cursorDown(1);
+        } else if (top > 0) {
+            self.cursorDownScroll() catch break;
+            top -= 1;
+        } else break;
+        self.cursor.page_row.semantic_prompt = .prompt_continuation;
+    }
+    self.cursorHorizontalAbsolute(@min(pr.x, self.pages.cols - 1));
+}
