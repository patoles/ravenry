+/// Ravenry (daemon/patches/ghostty-prompt-clear-top.patch): remove up to
+/// n blank rows from the end of the list, none that a tracked pin is on,
+/// so the screen's window moves up over the scrollback by that many rows.
+/// The scrollback keeps at least none; the screen keeps its rows.
+pub fn ravenryTrimBottom(self: *PageList, n: usize) usize {
+    const room = self.total_rows -| self.rows;
+    const want = @min(n, room);
+    if (want == 0) return 0;
+    const trimmed = self.trimTrailingBlankRows(@intCast(@min(want, std.math.maxInt(size.CellCountInt))));
+    self.total_rows -= trimmed;
+    return trimmed;
+}
