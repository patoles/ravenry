<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and later, at night (values-night would otherwise win over values-v31): the system's splash with the Ink (docs/PHONE.md, The launch): the 288 dp animated icon with no icon background, 800 ms. -->
<resources>
  <style name="Theme.Ravenry.Launch" parent="Theme.Ravenry">
    <!-- The app's window until the launch ends: the still mark where the splash leaves it, so a frame before the app's first draws shows it too. -->
    <item name="android:windowBackground">@drawable/launch_bg</item>
    <item name="android:windowSplashScreenBackground">@color/win</item>
    <item name="android:windowSplashScreenAnimatedIcon">@drawable/ink_splash</item>
    <item name="android:windowSplashScreenAnimationDuration">800</item>
  </style>
</resources>
