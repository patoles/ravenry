{
  "name": "@ravenry/desktop",
  "version": "0.1.22",
  "private": true,
  "description": "Ravenry's desktop app: the board beside real terminals.",
  "license": "GPL-3.0-only",
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node build.mjs",
    "start": "node build.mjs && electron .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.ts",
    "smoke": "node build.mjs && node tools/smoke.mjs",
    "shots": "node build.mjs && node tools/shots.mjs",
    "pack": "node scripts/pack.mjs",
    "check:package": "node tools/package-check.mjs"
  },
  "devDependencies": {
    "@ravenry/client": "0.0.0",
    "@types/node": "22.20.5",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/headless": "6.0.0",
    "@xterm/xterm": "6.0.0",
    "electron": "45.2.2",
    "electron-builder": "26.18.0",
    "electron-updater": "6.8.11",
    "esbuild": "0.28.2",
    "split.js": "1.6.5",
    "typescript": "7.0.2",
    "yaml": "^2.9.1"
  }
}
