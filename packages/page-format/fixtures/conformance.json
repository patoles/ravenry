  "items": [
    {
      "name": "read a note",
      "op": "read",
      "file": "items/note.md",
      "expect": {
        "title": "Boat clips through the dock on the left turn",
        "status": "new",
        "project": "paper-boat",
        "device": "Pixel 8",
        "picture": "shots/dock-clip.png",
        "file": "note.md"
      }
    },
    {
      "name": "read a file with no frontmatter: the title is its first heading",
      "op": "read",
      "file": "items/plain.md",
      "expect": {"title": "Splash sound plays twice", "file": "plain.md"}
    },
    {
      "name": "set a field, nothing changed meanwhile",
      "op": "patch",
      "file": "items/note.md",
      "base": "items/note.md",
      "patch": {"status": "fixed"},
      "expect": {"ok": true, "rebased": false, "text": "items/note.status-fixed.md"}
    },
    {
      "name": "set a field after another field changed: made again on the new text",
      "op": "patch",
      "file": "items/note.device-changed.md",
      "base": "items/note.md",
      "baseFields": true,
      "patch": {"status": "fixed"},
      "expect": {"ok": true, "rebased": true, "text": "items/note.device-changed.status-fixed.md"}
    },
    {
      "name": "set a field that changed meanwhile: a conflict, nothing written",
      "op": "patch",
      "file": "items/note.status-fixing.md",
      "base": "items/note.md",
      "baseFields": true,
      "patch": {"status": "fixed"},
      "expect": {
        "ok": false,
        "conflict": [
          {"field": "status", "base": "new", "current": "fixing", "wanted": "fixed"}
        ]
      }
    },
    {
      "name": "the file changed and the screen sent only its hash: a conflict",
      "op": "patch",
      "file": "items/note.device-changed.md",
      "base": "items/note.md",
      "patch": {"status": "fixed"},
      "expect": {
        "ok": false,
        "conflict": [
          {"field": "status", "base": null, "current": "new", "wanted": "fixed"}
        ]
      }
    },
    {
      "name": "change, add and remove fields; a value that would read as true is quoted",
      "op": "patch",
      "file": "items/note.md",
      "base": "items/note.md",
      "patch": {
        "device": "yes",
        "picture": null,
        "tags": ["dock", "left turn", "physics"]
      },
      "expect": {"ok": true, "rebased": false, "text": "items/note.added-removed.md"}
    },
    {
      "name": "a field on a file with no frontmatter adds one",
      "op": "patch",
      "file": "items/plain.md",
      "base": "items/plain.md",
      "patch": {"status": "new"},
      "expect": {"ok": true, "rebased": false, "text": "items/plain.status-new.md"}
    },
    {
      "name": "tick a box on its line",
      "op": "toggle",
      "file": "items/checklist.md",
      "box": {"line": 7, "text": "Write the changelog"},
      "expect": {"ok": true, "line": 7, "done": true, "moved": false, "text": "items/checklist.changelog-done.md"}
    },
    {
      "name": "the box moved down a line: found by its text",
      "op": "toggle",
      "file": "items/checklist.moved.md",
      "box": {"line": 7, "text": "Write the changelog"},
      "expect": {"ok": true, "line": 8, "done": true, "moved": true, "text": "items/checklist.moved.changelog-done.md"}
    },
    {
      "name": "the box was reworded: nothing changes",
      "op": "toggle",
      "file": "items/checklist.reworded.md",
      "box": {"line": 7, "text": "Write the changelog"},
      "expect": {"ok": false, "reason": "changed"}
    },
    {
      "name": "a box inside fenced code is not a box",
      "op": "toggle",
      "file": "items/checklist.md",
      "box": {"line": 13, "text": "Not a box: inside code"},
      "expect": {"ok": false, "reason": "changed"}
    },
    {
      "name": "the checklist of a file",
      "op": "checklist",
      "file": "items/checklist.md",
      "expect": [
        {"line": 6, "text": "Bump the version", "done": true, "indent": 0},
        {"line": 7, "text": "Write the changelog", "done": false, "indent": 0},
        {"line": 8, "text": "Mention the dock fix", "done": false, "indent": 2},
        {"line": 9, "text": "Tag the release", "done": false, "indent": 0}
      ]
    }
  ]
}
